<prefigure xmlns="https://prefigure.org" label="impulse-1">
    <diagram dimensions ="(300,300)" margins="(60,5,20,25)">
        <coordinates bbox="[-1,-1,3,4]"> 
            <!--
                bbox="[left,bottom,right,top]"
            -->
            <grid-axes vlabels = "no" hlabels = "no"/>

            <axes decorations="no" />
                <!--
                    hlabels="(specific outputs for horizontal axis)"
                    vlabels="(specific outputs for vertical axis)"
                -->
            <label anchor="(bbox[2],0)" alignment="e" offset="(8,0)">
                <m>t</m>
            </label>
            <label anchor="(0,bbox[3])" offset="(0,8)">
                <m>y</m>
            </label>
            <tick-mark location = "(1.5,0)">
                <m>t_0</m>
            </tick-mark>

            <tick-mark location = "(0,.25)" offset="(-50,10)" >
                <m>(1/2)/\varepsilon</m>
            </tick-mark>
            <tick-mark location = "(0,.5)" offset="(-30,10)">
                <m>1/\varepsilon</m>
            </tick-mark>
            <tick-mark location = "(0,1)" offset="(-30,20)">
                <m>2/\varepsilon</m>
            </tick-mark>
            <tick-mark location = "(0,2.5)" offset="(-30,10)">
                <m>4/\varepsilon</m>
            </tick-mark>

            <line endpoints="((0,.25),(3,.25))" stroke="black" thickness="2"/>
            <line endpoints="((.5,.5),(2.5,.5))" stroke="black" thickness="2"/>
                <line endpoints="((.5,.5),(.5,0))" dash="5 5"/>
                <line endpoints="((2.5,.5),(2.5,0))" dash="5 5"/>
            <line endpoints="((1,1),(2,1))" stroke="black" thickness="2"/>
                <line endpoints="((1,1),(1,0))" dash="5 5"/>
                <line endpoints="((2,1),(2,0))" dash="5 5"/>
            <line endpoints="((1.25,2.5),(1.75,2.5))" stroke="black" thickness="2"/>
                <line endpoints="((1.25,2.5),(1.25,0))" dash="5 5"/>
                <line endpoints="((1.75,2.5),(1.75,0))" dash="5 5"/>
            
        </coordinates>
    </diagram>
</prefigure>