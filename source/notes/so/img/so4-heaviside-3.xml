<prefigure xmlns="https://prefigure.org" label="heaviside-3">
    <diagram dimensions ="(300,300)" margins="(60,5,20,25)">
        <definition>
            f(x) = x
        </definition>
        <coordinates bbox="[-1,-1,3.5,2]"> 
            <!--
                bbox="[left,bottom,right,top]"
            -->
            <grid-axes hlabels = "no"/>

            <axes decorations="no" />
                <!--
                    hlabels="(specific outputs for horizontal axis)"
                    vlabels="(specific outputs for vertical axis)"
                -->
            <label anchor="(bbox[2],0)" alignment="e" offset="(8,0)">
                <m>t</m>
            </label>
            <label anchor="(0,bbox[3])" offset="(0,8)">
                <m>y</m>
            </label>
            <tick-mark location = "(2,0)">
                <m>2</m>
            </tick-mark>

            <line endpoints="((2,0),(3.5,0))" stroke="black" thickness="5"/>
            <graph function="f" domain="(0,2)" stroke="black" thickness="5"/>
            <point p="(2,2)" fill="red" size="7"/>
            <point p="(2,0)" fill="white" size="7"/>
            
        </coordinates>
    </diagram>

</prefigure>