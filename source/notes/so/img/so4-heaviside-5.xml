<prefigure xmlns="https://prefigure.org" label="heaviside-5">
    <diagram dimensions ="(300,300)" margins="(60,5,20,25)">
        <definition>
            f(x) = x
        </definition>
        <coordinates bbox="[-1,-1,5,3.5]"> 
            <!--
                bbox="[left,bottom,right,top]"
            -->
            <grid-axes />

            <axes decorations="no" />
                <!--
                    hlabels="(specific outputs for horizontal axis)"
                    vlabels="(specific outputs for vertical axis)"
                -->
            <label anchor="(bbox[2],0)" alignment="e" offset="(8,0)">
                <m>t</m>
            </label>
            <label anchor="(0,bbox[3])" offset="(0,8)">
                <m>y</m>
            </label>
            <tick-mark location = "(2,0)">
                <m>2</m>
            </tick-mark>

            <line endpoints="((0,0),(1,0))" stroke="black" thickness="5"/>
            <line endpoints="((1,0),(2,3))" stroke="black" thickness="5"/>
            <line endpoints="((2,3),(4,0))" stroke="black" thickness="5"/>
            <line endpoints="((4,0),(5,0))" stroke="black" thickness="5"/>
        </coordinates>
    </diagram>
</prefigure>