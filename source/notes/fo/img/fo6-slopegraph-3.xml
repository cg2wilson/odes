<prefigure xmlns="https://prefigure.org" label="slopefield-3">
    <diagram dimensions ="(300,300)" margins="(60,5,20,25)">
        <definition>
            f(t,y) = t - 2*t*y
        </definition>
        <coordinates bbox="[-2,-10,3,10.5]"> 
            <!--
                bbox="[left,bottom,right,top]"
            -->
            <grid-axes/>

            <axes decorations="yes"/>
                <!--
                    vlabels="(specific outputs for vertical axis)"
                -->
            <label anchor="(bbox[2],0)" alignment="e" offset="(8,0)">
                <m>t</m>
            </label>
            <label anchor="(0,bbox[3])" offset="(0,8)">
                <m>x(t)</m>
            </label>

            <definition>
                gap = 1
            </definition>

            <slope-field function="f" stroke="black" spacings="((-2,gap/2,5),(-10,gap,10))" arrows="yes" thickness="1"/>

            <plot-de-solution function="f" t0="-2" y0=".033" t1="3" stroke="blue"/>
            <plot-de-solution function="f" t0="-2" y0=".75" t1="3" stroke="red"/>
            <plot-de-solution function="f" t0="-1.75" y0=".6" t1="3" stroke="green"/>
        </coordinates>
    </diagram>

</prefigure>